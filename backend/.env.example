# Postgres connection strings. Local dev: see docker-compose.yml at repo root
# (DATABASE_URL alone is enough, DIRECT_URL can be left unset — direct and
# pooled are the same thing for a local single-connection Postgres).
#
# Supabase (or any host that fronts Postgres with a connection pooler):
# DATABASE_URL is the pooled/transaction-mode connection (port 6543,
# ?pgbouncer=true) the running app uses; DIRECT_URL is a session-mode
# connection Prisma needs for migrations (a transaction-mode pooler doesn't
# support the session state migrations require). Get both from Supabase's
# Project Settings -> Database page.
#
# Supabase's literal "Direct connection" host (db.<ref>.supabase.co:5432) is
# IPv6-only. If your network/host has no IPv6 egress, migrations will fail
# with a DNS ENOTFOUND — use the POOLER host in session mode instead (same
# host as DATABASE_URL, port 5432, no ?pgbouncer=true):
#   DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://hr:hr@localhost:5432/hr_portal?schema=public"
DIRECT_URL="postgresql://hr:hr@localhost:5432/hr_portal?schema=public"

# Backend HTTP server
PORT=4000
NODE_ENV=development

# Google OAuth 2.0 — restricted to the school's Workspace domain
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"
ALLOWED_GOOGLE_DOMAIN="kinbidhooschool.edu.mv"

# Session JWT (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# Field-level encryption key for national_id / bank details / salary grade.
# Must be a 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Frontend origin allowed to call the API with credentials
FRONTEND_ORIGIN="http://localhost:5173"

# Local-only auth bypass — NEVER set true outside development. Lets you log in
# as a seeded staff record without real Google OAuth credentials.
DEV_BYPASS_AUTH="true"

# Optional SMTP config for email notifications (logged to console if unset)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HR Portal <no-reply@kinbidhooschool.edu.mv>"

# ZKTime 5.0 import watch folder (defaults to backend/import-watch/incoming)
ZKTIME_WATCH_DIR=""

# Direct LAN polling of a ZKTeco/ZKTime terminal, as an alternative (or
# addition) to dropping exports in the watch folder above. Enabled whenever
# ZKTIME_DEVICE_IP is set, unless ZKTIME_DEVICE_ENABLED=false. The device's
# protocol carries no punch-direction field, so direction is inferred the
# same way a status-column-less CSV export is (Check In/Out alternation per
# device per day) — see backend/src/jobs/zktimeDevicePoll.ts.
ZKTIME_DEVICE_IP=""
ZKTIME_DEVICE_PORT="4370"
ZKTIME_DEVICE_POLL_INTERVAL_MINUTES="5"
ZKTIME_DEVICE_ENABLED=""

# Fallback attendance shift window for staff not assigned to a StaffGroup
# (real per-group sign-in time/working hours take precedence)
SHIFT_START="08:00"
GRACE_PERIOD_MINUTES="10"
STANDARD_DAILY_HOURS="6"

# Uniform eligibility thresholds (school-wide, regardless of staff group)
HOLIDAY_ATTENDANCE_THRESHOLD_HOURS="3"
OVERTIME_ELIGIBLE_THRESHOLD_HOURS="8"

# Overtime policy (mirrors the legacy portal's General Settings page)
OT_MAX_CONTINUOUS_MINUTES="480"
OT_SUBMISSION_WINDOW_DAYS="3"
OT_PERIOD_START_DAY="16"

# Overtime rate/capping formula for the Overtime Report — verified exact
# against a real payroll workbook's "Formula Deviation"/"OT CAP" sheets.
# Per-minute rate = (Basic Salary / OT_RATE_CALENDAR_DAYS) /
# (staff's standard daily hours * 60) * the relevant multiplier.
OT_RATE_CALENDAR_DAYS="30"
OT_NORMAL_RATE_MULTIPLIER="1.25"
OT_HOLIDAY_RATE_MULTIPLIER="1.5"
OT_SELF_CAP_PERCENT="0.1"
OT_BUDGET_CAP_PERCENT="0.1"
