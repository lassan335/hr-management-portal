// HR Management Portal (Kinbidhoo School) — core schema.
// Sensitive columns suffixed `Enc` hold AES-256-GCM ciphertext written/read only
// via backend/src/lib/encryption.ts — never plaintext, never returned to
// Staff/HOD-facing serializers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (Supavisor, transaction mode) — used by the running app.
  url       = env("DATABASE_URL")
  // Direct connection — used only for migrations, which need a session
  // connection rather than a transaction-mode pooler.
  directUrl = env("DIRECT_URL")
}

enum Role {
  STAFF
  HOD
  HR_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Which of the academic calendar's holiday groups a staff member follows —
/// distinct from Role (access level) and StaffGroup (shift hours). Teachers
/// get the school's term-break holidays (Holiday.scope TEACHING); admin/
/// support staff work through those and only get scope ALL days off.
enum StaffCategory {
  TEACHING
  NON_TEACHING
}

/// Which staff category a Holiday applies to. ALL = public holiday
/// (everyone off); TEACHING = school term-break day (teachers only,
/// admin/support staff still work); NON_TEACHING exists for symmetry but
/// isn't expected to see real use (admin-only closures are unusual).
enum HolidayScope {
  ALL
  TEACHING
  NON_TEACHING
}

/// Pay/attendance treatment for a holiday — orthogonal to HolidayScope
/// (who it applies to). GOVERNMENT: same OT rate as a normal day
/// (otNormalRateMultiplier), OT-eligible only after the standard daily-hours
/// threshold. PUBLIC: elevated OT rate (otHolidayRateMultiplier), OT-eligible
/// from the first minute worked. Every Saturday is GOVERNMENT and every
/// Friday is PUBLIC regardless of the Holiday table (see
/// holidays/service.ts's resolveDayType) — declared calendar holidays
/// default PUBLIC unless HR sets this explicitly.
enum HolidayType {
  GOVERNMENT
  PUBLIC
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  PART_TIME
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
}

/// Shared staff -> HOD -> HR/Admin approval chain (overtime, leave, corrections).
/// Staff edit requests skip straight to PENDING_HR (single HR approval step).
enum ApprovalStatus {
  PENDING_HOD
  PENDING_HR
  APPROVED
  REJECTED
}

enum PunchType {
  CHECK_IN
  CHECK_OUT
  BREAK_IN
  BREAK_OUT
  OVERTIME_IN
  OVERTIME_OUT
}

enum AttendanceSource {
  MANUAL
  IMPORT
  DEVICE
}

enum DocumentType {
  ID
  CONTRACT
  CERTIFICATE
  PHOTO
  OTHER
}

enum NotificationType {
  OVERTIME_SUBMITTED
  OVERTIME_APPROVED
  OVERTIME_REJECTED
  OVERTIME_WORK_COMPLETED
  OVERTIME_TASK_ASSIGNED
  LEAVE_SUBMITTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  EDIT_REQUEST_SUBMITTED
  EDIT_REQUEST_APPROVED
  EDIT_REQUEST_REJECTED
  ATTENDANCE_CORRECTION_SUBMITTED
  ATTENDANCE_CORRECTION_REVIEWED
  ATTENDANCE_IMPORT_FAILED
  ATTENDANCE_DEVICE_RESOLVED
}

model Department {
  id         String   @id @default(cuid())
  name       String   @unique
  hodStaffId String?  @unique
  hod        Staff?   @relation("DepartmentHod", fields: [hodStaffId], references: [id])
  staff      Staff[]  @relation("StaffDepartment")
  overtimeRates OvertimeRate[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Working-hours framework, mirroring the legacy v7.0 "Staff Groups" concept
/// (e.g. "New Framework Staff": 06:45 sign-in, 8h/day vs "Old Framework
/// Staff": 06:45 sign-in, 6h/day). Drives attendance late-arrival and
/// overtime-threshold flagging per staff member instead of one global shift.
model StaffGroup {
  id            String  @id @default(cuid())
  name          String  @unique
  frameworkType String
  /// "HH:mm" — parsed the same way as env.ts's shift settings.
  signInTime    String
  workingHours  Int
  /// Group-level overtime cost capping (% of basic salary) — recorded from
  /// the legacy settings but not yet enforced; salary isn't stored as a
  /// plain numeric field this can be computed against (see StaffBankDetail).
  groupCapping  Boolean @default(false)
  staff         Staff[]
}

model Staff {
  id               String   @id @default(cuid())
  staffId          String   @unique
  fullName         String
  nationalIdEnc    String
  dob              DateTime
  gender           Gender
  contactNumber    String
  personalEmail    String
  homeAddress      String
  emergencyContact String

  googleEmail String @unique
  role        Role   @default(STAFF)

  departmentId       String
  department         Department @relation("StaffDepartment", fields: [departmentId], references: [id])
  /// Working-hours framework (sign-in time, standard daily hours) used for
  /// attendance late-arrival/overtime-threshold flagging. Nullable — staff
  /// with no group assigned fall back to env.ts's default shift settings.
  staffGroupId       String?
  staffGroup         StaffGroup? @relation(fields: [staffGroupId], references: [id])
  designation        String
  employmentType     EmploymentType
  dateJoined         DateTime
  contractEndDate    DateTime?
  reportingManagerId String?
  reportingManager   Staff?  @relation("ReportingChain", fields: [reportingManagerId], references: [id])
  reports            Staff[] @relation("ReportingChain")

  /// ZKTime 5.0 biometric device user id, once matched/assigned.
  deviceUserId String? @unique

  /// HR/Admin-set flag (independent of `role`, which most real staff carry
  /// as plain STAFF regardless of their actual job title) marking someone
  /// allowed to directly assign a pre-approved overtime task to another
  /// staff member — see OvertimeRequest.assignedById.
  canSupervise Boolean @default(false)

  /// Which academic-calendar holiday group this staff member follows — see
  /// StaffCategory. Defaults NON_TEACHING (admin/support); HR sets TEACHING
  /// explicitly for teaching staff.
  category StaffCategory @default(NON_TEACHING)

  status          StaffStatus @default(ACTIVE)
  /// Bumped on logout, status change, or role/department change to
  /// invalidate any outstanding session JWTs immediately (see lib/auth.ts).
  sessionVersion  Int         @default(0)
  photoDocumentId String?     @unique
  photoDocument   StaffDocument? @relation("ProfilePhoto", fields: [photoDocumentId], references: [id])

  hodOfDepartment Department? @relation("DepartmentHod")

  qualifications StaffQualification[]
  documents      StaffDocument[]      @relation("StaffDocuments")
  bankDetails    StaffBankDetail?
  statusHistory  StaffStatusHistory[]
  editRequests   StaffEditRequest[]
  salarySlipAdjustments SalarySlipAdjustment[]

  overtimeRequests   OvertimeRequest[] @relation("OvertimeStaff")
  overtimeHodReviews OvertimeRequest[] @relation("OvertimeHodReviewer")
  overtimeHrReviews  OvertimeRequest[] @relation("OvertimeHrReviewer")
  overtimeAssigned   OvertimeRequest[] @relation("OvertimeAssignedBy")

  timeEntries        TimeEntry[]
  attendanceDevice   AttendanceDevice?
  correctionRequests AttendanceCorrectionRequest[] @relation("CorrectionStaff")
  correctionReviews  AttendanceCorrectionRequest[] @relation("CorrectionReviewer")

  leaveRequests   LeaveRequest[] @relation("LeaveStaff")
  leaveHodReviews LeaveRequest[] @relation("LeaveHodReviewer")
  leaveHrReviews  LeaveRequest[] @relation("LeaveHrReviewer")
  leaveBalances   LeaveBalance[]

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffQualification {
  id          String   @id @default(cuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id])
  type        String
  institution String
  year        Int?
  notes       String?
  createdAt   DateTime @default(now())
}

/// Also used for the profile photo (docType = PHOTO), so photos get the same
/// access-controlled storage as ID/contract/certificate uploads.
model StaffDocument {
  id           String       @id @default(cuid())
  staffId      String
  staff        Staff        @relation("StaffDocuments", fields: [staffId], references: [id])
  docType      DocumentType
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  uploadedBy   String
  uploadedAt   DateTime     @default(now())

  profileOf Staff? @relation("ProfilePhoto")
}

model StaffBankDetail {
  id               String   @id @default(cuid())
  staffId          String   @unique
  staff            Staff    @relation(fields: [staffId], references: [id])
  bankName         String
  accountNumberEnc String
  salaryGradeEnc   String
  /// Monthly payroll figures used to generate salary slips — encrypted like
  /// the rest of this table, HR/Admin-only. Nullable: a staff member with no
  /// payroll figures configured yet simply can't have a slip generated.
  basicSalaryEnc      String?
  serviceAllowanceEnc String?
  jobAllowanceEnc     String?
  updatedAt        DateTime @updatedAt
}

/// Per-staff, per-pay-period manual payroll inputs that have no other source
/// of truth in this system — third-party loan/finance deductions (e.g. MIB),
/// ad-hoc "Other" deductions, HR-confirmed unexplained-absence deductions,
/// and the attendance-allowance daily rate. Everything else on the salary
/// slip (payable days, late-minute deduction, overtime allowance) is
/// computed from attendance/leave/overtime data already tracked elsewhere.
model SalarySlipAdjustment {
  id      String @id @default(cuid())
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])
  month   Int
  year    Int

  mibDeduction              Decimal @default(0) @db.Decimal(10, 2)
  otherDeduction            Decimal @default(0) @db.Decimal(10, 2)
  absentDeduction           Decimal @default(0) @db.Decimal(10, 2)
  attendanceAllowancePerDay Decimal @default(0) @db.Decimal(10, 2)

  updatedBy String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([staffId, month, year])
}

model StaffStatusHistory {
  id        String       @id @default(cuid())
  staffId   String
  staff     Staff        @relation(fields: [staffId], references: [id])
  oldStatus StaffStatus?
  newStatus StaffStatus
  changedBy String
  reason    String?
  changedAt DateTime     @default(now())
}

/// Staff self-service edit requests. Sensitive fields (salary, employment type,
/// national ID, bank details) always route through here rather than direct writes.
model StaffEditRequest {
  id             String         @id @default(cuid())
  staffId        String
  staff          Staff          @relation(fields: [staffId], references: [id])
  field          String
  currentValue   String?
  requestedValue String
  status         ApprovalStatus @default(PENDING_HR)
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())
}

model OvertimeRate {
  id            String     @id @default(cuid())
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id])
  weekdayRate   Decimal    @db.Decimal(10, 2)
  weekendRate   Decimal    @db.Decimal(10, 2)
  holidayRate   Decimal    @db.Decimal(10, 2)
  effectiveFrom DateTime   @default(now())
}

/// Pre-approval model, matching the legacy v7.0 workflow: staff request
/// overtime for a planned time window BEFORE doing the work, a supervisor
/// approves it, the staff member does the work and punches OVERTIME_IN/
/// OVERTIME_OUT on the biometric time clock, and that punch pair (imported
/// via ZKTime — see jobs/zktimeImport.ts's reconcileOvertimeCompletion call)
/// is what marks the request "Work Completed" — hours/cost for payroll only
/// count once completed (an approved-but-never-done slot is not paid). HR
/// retains a manual override (completionSource "MANUAL") for when the
/// device punch is missing or delayed.
model OvertimeRequest {
  id      String   @id @default(cuid())
  staffId String
  staff   Staff    @relation("OvertimeStaff", fields: [staffId], references: [id])
  /// Calendar date of the slot, derived from timeIn at submission.
  date    DateTime
  timeIn  DateTime
  timeOut DateTime
  reason  String
  notes   String?
  /// Weekday/weekend is derived from `date`; holiday must be flagged
  /// explicitly since it isn't purely a function of the calendar date.
  isHoliday Boolean  @default(false)

  status        ApprovalStatus @default(PENDING_HOD)
  hodReviewerId String?
  hodReviewer   Staff?         @relation("OvertimeHodReviewer", fields: [hodReviewerId], references: [id])
  hodReviewedAt DateTime?
  hrReviewerId  String?
  hrReviewer    Staff?         @relation("OvertimeHrReviewer", fields: [hrReviewerId], references: [id])
  hrReviewedAt  DateTime?

  /// Set when a supervisor (Staff.canSupervise, or HR/Admin) creates this
  /// task directly for someone else, already pre-approved — skips the
  /// normal staff-submits/HOD-then-HR-approves flow entirely (status is
  /// APPROVED from creation, hodReviewerId/hrReviewerId stay null since it
  /// never went through that chain). Null for an ordinary self-submitted
  /// request.
  assignedById String?
  assignedBy   Staff?  @relation("OvertimeAssignedBy", fields: [assignedById], references: [id])

  /// Staff-initiated withdrawal — distinct from HOD/HR rejecting it.
  cancelled   Boolean   @default(false)
  cancelledAt DateTime?

  /// Set once a matching OVERTIME_IN/OVERTIME_OUT punch pair is found for
  /// this staff member on this date (see reconcileOvertimeCompletion), or by
  /// an HR manual override. Only APPROVED + completed + not cancelled slots
  /// count for payroll.
  workCompleted   Boolean   @default(false)
  workCompletedAt DateTime?
  /// "DEVICE" (matched a real time-clock punch pair) or "MANUAL" (HR
  /// override, used when device data is missing/delayed). Null until
  /// completed.
  completionSource String?
  /// HR's reason for a manual override — only meaningful when
  /// completionSource is "MANUAL".
  completionNote    String?

  createdAt DateTime @default(now())
}

/// Registry of ZKTime 5.0 biometric device user ids seen in imports. Rows start
/// with staffId = null (unmatched) until an admin resolves them by linking to a
/// staff record, at which point staff.deviceUserId is also backfilled.
model AttendanceDevice {
  id           String   @id @default(cuid())
  deviceUserId String   @unique
  staffId      String?  @unique
  staff        Staff?   @relation(fields: [staffId], references: [id])
  label        String?
  createdAt    DateTime @default(now())
}

model TimeEntry {
  id        String           @id @default(cuid())
  staffId   String
  staff     Staff            @relation(fields: [staffId], references: [id])
  timestamp DateTime
  punchType PunchType
  source    AttendanceSource @default(MANUAL)
  createdAt DateTime         @default(now())

  @@index([staffId, timestamp])
}

/// One row per ZKTime import run (manual upload or file-watcher pickup).
model AttendanceSyncLog {
  id             String                     @id @default(cuid())
  fileName       String
  /// SHA-256 of the file content — a second line of defense against
  /// importing the same export twice (manual upload + watcher racing, or a
  /// human re-uploading the same file), independent of which directory it
  /// arrived through.
  fileHash       String?
  processedCount Int
  matchedCount   Int
  unmatchedCount Int
  /// Set when parsing failed entirely (malformed columns, unreadable file) —
  /// surfaced in the admin UI instead of failing silently.
  failed         Boolean                    @default(false)
  failureReason  String?
  importedBy     String?
  importedAt     DateTime                   @default(now())
  unmatchedEntries AttendanceUnmatchedEntry[]

  @@index([fileHash])
}

/// Rows from an import run whose device_user_id didn't match any staff —
/// surfaced in the admin review queue instead of being silently dropped.
model AttendanceUnmatchedEntry {
  id              String            @id @default(cuid())
  syncLogId       String
  syncLog         AttendanceSyncLog @relation(fields: [syncLogId], references: [id])
  deviceUserId    String
  timestamp       DateTime
  punchType       PunchType
  resolved        Boolean           @default(false)
  resolvedStaffId String?
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
}

model AttendanceCorrectionRequest {
  id                 String         @id @default(cuid())
  staffId            String
  staff              Staff          @relation("CorrectionStaff", fields: [staffId], references: [id])
  timeEntryId        String?
  date               DateTime
  requestedPunchType PunchType
  requestedTime      DateTime
  reason             String

  status       ApprovalStatus @default(PENDING_HOD)
  reviewerId   String?
  reviewer     Staff?         @relation("CorrectionReviewer", fields: [reviewerId], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
}

model LeaveType {
  id          String @id @default(cuid())
  name        String @unique
  /// Free-text/JSON accrual description (e.g. "1.5 days/month") — kept simple
  /// for a v1; a dedicated accrual-rule engine can replace this later.
  accrualRule String?
  isCustom    Boolean @default(false)
  /// Whether approving a request of this type deducts from the staff
  /// member's balance (false for e.g. Unpaid Leave). An explicit flag
  /// instead of matching on the name string.
  deductsBalance Boolean @default(true)

  balances LeaveBalance[]
  requests LeaveRequest[]
}

model LeaveBalance {
  id          String    @id @default(cuid())
  staffId     String
  staff       Staff     @relation(fields: [staffId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  balanceDays Decimal   @db.Decimal(5, 2)

  @@unique([staffId, leaveTypeId, year])
}

model LeaveRequest {
  id          String    @id @default(cuid())
  staffId     String
  staff       Staff     @relation("LeaveStaff", fields: [staffId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  reason      String?

  status        ApprovalStatus @default(PENDING_HOD)
  hodReviewerId String?
  hodReviewer   Staff?         @relation("LeaveHodReviewer", fields: [hodReviewerId], references: [id])
  hodReviewedAt DateTime?
  hrReviewerId  String?
  hrReviewer    Staff?         @relation("LeaveHrReviewer", fields: [hrReviewerId], references: [id])
  hrReviewedAt  DateTime?

  createdAt DateTime @default(now())
}

/// School term/holiday calendar. Leave requests overlapping a blocksLeave range
/// are rejected at the API layer before entering the approval chain.
model TermCalendar {
  id          String   @id @default(cuid())
  termName    String
  startDate   DateTime
  endDate     DateTime
  blocksLeave Boolean  @default(false)
}

/// One-off public holidays / non-working days that fall on a weekday —
/// the recurring Friday/Saturday weekend is handled by day-of-week in
/// timesheet.ts and doesn't need a row here. A date present in either
/// place counts as a holiday for holidayAttendanceEligible/OT purposes.
model Holiday {
  id          String       @id @default(cuid())
  date        DateTime     @unique @db.Date
  description String
  /// Which staff category this day off applies to — see HolidayScope.
  scope       HolidayScope @default(ALL)
  /// Pay/attendance treatment — see HolidayType.
  type        HolidayType  @default(PUBLIC)
  createdAt   DateTime     @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  staffId   String
  staff     Staff            @relation(fields: [staffId], references: [id])
  type      NotificationType
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  ipAddress String?
  userAgent String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
}
